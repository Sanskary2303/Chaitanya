# Enhanced MCP Features - Environment Configuration Examples
# Copy this to your .env file and configure as needed

# ===========================================
# IP-based MCP Server Configuration
# ===========================================

# Example: External API MCP Server with IP and Port
MCP_IP_SERVER_HOST=api.example.com
MCP_IP_SERVER_PORT=443

# JWT Token for authentication
MCP_JWT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c

# API Key for authentication
MCP_API_SERVER_HOST=internal-api.company.com
MCP_API_SERVER_PORT=8080
MCP_API_KEY=sk-1234567890abcdef

# Basic Authentication (optional)
MCP_BASIC_USERNAME=admin
MCP_BASIC_PASSWORD=secretpassword

# ===========================================
# Swagger-generated MCP Configuration
# ===========================================

# Swagger/OpenAPI specification URL
SWAGGER_SPEC_URL=https://petstore.swagger.io/v2/swagger.json

# Alternative Swagger specs to try:
# SWAGGER_SPEC_URL=https://api.github.com/swagger.json
# SWAGGER_SPEC_URL=https://httpbin.org/spec.json
# SWAGGER_SPEC_URL=https://jsonplaceholder.typicode.com/swagger.json

# ===========================================
# TLS/SSL Configuration (optional)
# ===========================================

# Custom CA certificate path (if needed)
MCP_TLS_CA_PATH=/path/to/ca-certificate.pem

# Client certificate and key (for mutual TLS)
MCP_TLS_CERT_PATH=/path/to/client-certificate.pem
MCP_TLS_KEY_PATH=/path/to/client-private-key.pem

# Allow self-signed certificates (development only)
MCP_TLS_REJECT_UNAUTHORIZED=false

# ===========================================
# Advanced Configuration
# ===========================================

# Custom timeout for IP-based servers (milliseconds)
MCP_IP_TIMEOUT=45000

# Custom output directory for Swagger-generated clients
SWAGGER_OUTPUT_DIR=./tmp/swagger-generated

# Enable debug logging for MCP connections
DEBUG=mcp:*

# ===========================================
# Example Server Configurations
# ===========================================

# You can register servers using these formats:

# 1. IP Server with JWT:
# register-mcp-server id:api-jwt name:"External API (JWT)" type:ip host:api.example.com port:443 protocol:https auth:jwt token:YOUR_JWT_TOKEN

# 2. IP Server with API Key:
# register-mcp-server id:api-key name:"External API (Key)" type:ip host:127.0.0.1 port:8080 protocol:http auth:api-key token:YOUR_API_KEY

# 3. Swagger-generated server:
# register-mcp-server id:petstore name:"Petstore API" type:swagger-npx swagger:https://petstore.swagger.io/v2/swagger.json

# 4. Custom Swagger with package name:
# register-mcp-server id:custom-api name:"Custom API" type:swagger-npx swagger:YOUR_SWAGGER_URL package:mcp-custom-api

