      "name": "File Operations",
      "item": [
        {
          "name": "Read File - Package.json",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"read file package.json\",\n  \"enableFileOperations\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enhanced-chatbot",
              "host": ["{{baseUrl}}"],
              "path": ["enhanced-chatbot"]
            }
          }
        },
