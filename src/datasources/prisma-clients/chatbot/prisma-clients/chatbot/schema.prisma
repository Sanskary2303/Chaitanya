generator client {
  provider        = "prisma-client-js"
  output          = "./prisma-clients/chatbot"
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String?
  avatar       String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  chatSessions ChatSession[]
  documents    Document[]
  repositories GitHubRepository[]

  @@map("users")
}

model ChatSession {
  id        String    @id @default(cuid())
  userId    String?
  title     String?
  isActive  Boolean   @default(true)
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User?     @relation(fields: [userId], references: [id])
  messages  Message[]

  @@map("chat_sessions")
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String
  metadata  Json?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}

model Document {
  id            String        @id @default(cuid())
  userId        String?
  filename      String
  originalName  String
  mimeType      String
  size          Int
  content       String?
  extractedText String?
  metadata      Json?
  status        String        @default("PROCESSING")
  uploadPath    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User?         @relation(fields: [userId], references: [id])
  vectorChunks  VectorChunk[]

  @@map("documents")
}

model GitHubRepository {
  id           String        @id @default(cuid())
  userId       String?
  repoUrl      String
  repoName     String
  branch       String        @default("main")
  lastSyncAt   DateTime?
  status       String        @default("PENDING")
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User?         @relation(fields: [userId], references: [id])
  vectorChunks VectorChunk[]

  @@unique([repoUrl, branch])
  @@map("github_repositories")
}

model VectorChunk {
  id         String            @id @default(cuid())
  docId      String?
  repoId     String?
  chunkIndex Int
  content    String
  embedding  String?
  metadata   Json?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  repository GitHubRepository? @relation(fields: [repoId], references: [id], onDelete: Cascade)
  document   Document?         @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, chunkIndex])
  @@unique([repoId, chunkIndex])
  @@index([docId])
  @@index([repoId])
  @@map("vector_chunks")
}

model SystemPrompt {
  id                  String   @id @default(cuid())
  name                String   @unique
  description         String?
  coreSystemPrompt    String
  toolKnowledgePrompt String
  isActive            Boolean  @default(false)
  isDefault           Boolean  @default(false)
  category            String   @default("general")
  tags                Json?
  version             String   @default("1.0.0")
  createdBy           String?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("system_prompts")
}
